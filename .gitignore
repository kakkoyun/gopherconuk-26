# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Per-talk living plans/trackers (gitignored — local only)
plans/

# Slide build artifacts and staged theme resources
talks/**/slides/presentation.html
talks/**/slides/presentation.pdf
talks/go-benchmarks-lying/slides/assets/
talks/go-benchmarks-lying/slides/fonts/
talks/without-a-single-line/slides/assets/
talks/without-a-single-line/slides/fonts/
themes/gophercon-datadog/.theme-check.pdf

# Agent runtime artifacts
.pi-subagents/
__pycache__/

# Compiled CLI binaries
tools/cli/*/kubectl-obi
tools/cli/*/kubectl-obi.exe
tools/cli/*/kubectl-profiler
tools/cli/*/kubectl-profiler.exe
